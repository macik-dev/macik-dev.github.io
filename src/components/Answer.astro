---
/**
 * Спойлер с ответом. Сделан на <details>, поэтому работает без JavaScript,
 * находится поиском по странице и раскрывается при печати.
 *
 * Подпись подставляется сама: у устного задания «Показать ответ»,
 * у письменного — «Показать решение».
 */
interface Props {
  label?: string;
}
const { label = 'Показать ответ' } = Astro.props;
---
<details>
  <summary>{label}</summary>
  <div class="ans"><slot /></div>
</details>
